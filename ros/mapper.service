[Unit]
Description=Mapeo 4WD: teleop + odometria + RPLIDAR + slam_toolbox + foxglove
After=multi-user.target

[Service]
Type=simple
User=felipe
# esperar sincronizacion NTP (max 60 s) para que ningun nodo nazca con hora que luego salte
ExecStartPre=-/bin/bash -c 'for i in $(seq 30); do timedatectl show -p NTPSynchronized --value | grep -q yes && exit 0; sleep 2; done; exit 0'
ExecStartPre=-/usr/sbin/ip link set lo multicast on
ExecStart=/bin/bash /home/felipe/teleop/mapper.sh
Restart=always
RestartSec=3
KillMode=mixed

[Install]
WantedBy=multi-user.target
